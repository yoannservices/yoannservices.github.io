# Copie ce fichier en ".env" à la racine du projet avant de lancer
# `docker compose up`. Ce fichier n'est utilisé qu'en local, jamais commité.

# Clé secrète de l'API Claude (Anthropic) utilisée par le backend pour
# répondre dans le chat. À obtenir sur console.anthropic.com, puis à coller
# ici dans ton fichier .env local (jamais dans le code ni dans Git).
ANTHROPIC_API_KEY=

# Optionnel : chemin du fichier SQLite des comptes. Si rien n'est écrit, c'est
# backend/nexus.db (à côté de main.py). Dans l'image Docker, la valeur est déjà
# fixée à /data/nexus.db : n'y touche pas là-bas.
# DATABASE_PATH=

# Optionnel : ports du backend et du frontend en développement (./start.sh et
# ./stop.sh). Utile sur le serveur partagé de l'école, où chaque élève a ses
# ports personnels. Sans ces lignes, ce sont 8000 et 5173 par défaut.
# BACKEND_PORT=8000
# FRONTEND_PORT=5173
