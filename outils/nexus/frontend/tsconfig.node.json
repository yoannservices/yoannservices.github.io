{
  // Configuration de vite.config.ts (le fichier de configuration de Vite).
  // Il est vérifié par `tsc -b`, mais sa sortie va dans node_modules/.tmp
  // pour ne pas laisser de fichiers .js à côté de vite.config.ts.
  "compilerOptions": {
    "composite": true,
    "outDir": "node_modules/.tmp/tsconfig.node",
    "skipLibCheck": true,

    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts"]
}
